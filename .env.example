# ── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: lock the bot to a single owner (numeric Telegram user id).
# When set, only this user can run commands. Leave empty for open DM access.
OWNER_TELEGRAM_ID=

# Optional: refuse to answer commands in group chats (default false)
BOT_DM_ONLY=false

# ── Paybox ──────────────────────────────────────────────────────────────────
# Auth Token from the Paybox app (starts with pbx_live_)
PAYBOX_API_KEY=pbx_live_your_auth_token_here
PAYBOX_API_URL=https://api.paybox.sh

# Signing Key from the Paybox app (starts with pbxk1.)
# REQUIRED for transfers, swaps, message signing and x402 payments —
# without it the bot runs in read-only mode (balances, markets, buy links).
PAYBOX_SIGNING_KEY=pbxk1.your_signing_key_here

# ── AI agent (optional) ─────────────────────────────────────────────────────
# OpenAI-compatible API. Set to enable natural-language mode ("send 5 USDC to @alice").
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# Optional: point at any OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Webhook mode (optional; defaults to long polling) ───────────────────────
# BOT_WEBHOOK_URL=https://your-domain.com
# BOT_WEBHOOK_PATH=/webhook-<random>   # randomize this to reduce probing
# BOT_WEBHOOK_SECRET=your_long_random_secret_here  # REQUIRED in webhook mode — Telegram sends X-Telegram-Bot-Api-Secret-Token
# BOT_PORT=3000

# ── Open-deployment acknowledgement ─────────────────────────────────────────
# When OWNER_TELEGRAM_ID is unset the bot is open to anyone who knows its handle.
# Money + sensitive commands are BLOCKED unless you explicitly set PAYBOX_OPEN_MODE=1.
# PAYBOX_OPEN_MODE=1

# ── Network RPCs (public defaults; override for reliability/keys) ───────────
# RPC_ETHEREUM=https://ethereum-rpc.publicnode.com
# RPC_BASE=https://mainnet.base.org
# RPC_SOLANA=https://api.mainnet-beta.solana.com

# ── Behaviour ───────────────────────────────────────────────────────────────
# Max time to wait for a passkey approval before giving up (ms)
REQUEST_TIMEOUT_MS=300000
# Request polling interval (ms)
POLL_INTERVAL_MS=4000
# How long an AI confirm-before-send card stays valid (ms, default 90000)
# AGENT_CONFIRM_TIMEOUT_MS=90000
# How long the on-chain tx watcher follows a broadcast (ms, default 600000)
# TX_CONFIRM_TIMEOUT_MS=600000

# ── Scheduler (new in v2.1) ─────────────────────────────────────────────────
# How often the scheduler checks for due jobs (ms, default 20000)
# SCHEDULER_TICK_MS=20000
# Timezone for /schedule daily … jobs (IANA name, default UTC)
# SCHEDULER_TZ=Asia/Jakarta

# Where the address book + stats are stored
DATA_DIR=data
# debug | info | warn | error
LOG_LEVEL=info
