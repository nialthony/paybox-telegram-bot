# ── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: lock the bot to a single owner (numeric Telegram user id).
# When set, only this user can run commands. Leave empty for open DM access.
OWNER_TELEGRAM_ID=

# Optional: refuse to answer commands in group chats (default false)
BOT_DM_ONLY=false

# ── Paybox ──────────────────────────────────────────────────────────────────
# Auth Token from the Paybox app (starts with pbx_live_)
PAYBOX_API_KEY=pbx_live_your_auth_token_here
PAYBOX_API_URL=https://api.paybox.sh

# Signing Key from the Paybox app (starts with pbxk1.)
# REQUIRED for transfers, swaps, message signing and x402 payments —
# without it the bot runs in read-only mode (balances, markets, buy links).
PAYBOX_SIGNING_KEY=pbxk1.your_signing_key_here

# ── AI agent (optional) ─────────────────────────────────────────────────────
# OpenAI-compatible API. Set to enable natural-language mode ("send 5 USDC to @alice").
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# Optional: point at any OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Webhook mode (optional; defaults to long polling) ───────────────────────
# BOT_WEBHOOK_URL=https://your-domain.com
# BOT_WEBHOOK_PATH=/webhook
# BOT_PORT=3000

# ── Network RPCs (public defaults; override for reliability/keys) ───────────
# RPC_ETHEREUM=https://ethereum-rpc.publicnode.com
# RPC_BASE=https://mainnet.base.org
# RPC_SOLANA=https://api.mainnet-beta.solana.com

# ── Behaviour ───────────────────────────────────────────────────────────────
# Max time to wait for a passkey approval before giving up (ms)
REQUEST_TIMEOUT_MS=300000
# Request polling interval (ms)
POLL_INTERVAL_MS=4000
# Where the address book + stats are stored
DATA_DIR=data
# debug | info | warn | error
LOG_LEVEL=info
