# Required runtime credentials. Keep live values in managed secret storage only.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
PAYBOX_API_KEY=pbx_live_your_auth_token_here
PAYBOX_API_URL=https://api.paybox.sh

# Optional signing capability. Treat this as a high-sensitivity secret.
# PAYBOX_SIGNING_KEY=pbxk1_your_signing_key_here

# Optional natural-language helper. It can prepare guidance but never initiates transfers.
# OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Wallet transfers are OFF by default. Do not enable them until the installed
# Paybox SDK transfer contract has been verified with controlled staging tests.
ENABLE_WALLET_TRANSFERS=false
PAYBOX_TRANSFER_ADAPTER_CONFIRMED=false

# The current code runs in long-polling mode. Webhook deployment requires a
# verified HTTPS endpoint and Telegram webhook secret-token validation.
# BOT_WEBHOOK_URL=https://your-domain.example/webhook
# BOT_WEBHOOK_SECRET=replace-with-a-random-secret
