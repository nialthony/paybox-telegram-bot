# Telegram Bot Token (dari @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Paybox Configuration
PAYBOX_API_KEY=pbx_live_your_api_key_here
PAYBOX_API_URL=https://api.paybox.sh

# Optional: Paybox Signing Key (untuk autonomous signing)
PAYBOX_SIGNING_KEY=pbxk1.your_signing_key_here

# Bot Settings
BOT_WEBHOOK_URL=https://your-domain.com/webhook
BOT_PORT=3000
