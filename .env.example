# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Paybox Configuration
# Use the "AUTH TOKEN" from the Paybox App (starts with pbx_live_)
PAYBOX_API_KEY=pbx_live_your_auth_token_here
PAYBOX_API_URL=https://api.paybox.sh

# Optional: Use the "SIGNING KEY" from the Paybox App (starts with pbxk1_)
# Required for autonomous signing without manual approval for every transaction.
PAYBOX_SIGNING_KEY=pbxk1.your_signing_key_here

# AI Agent Settings (Optional but recommended)
# Use OpenAI (GPT-4) to enable Natural Language Mode
OPENAI_API_KEY=sk-your-openai-api-key-here

# Bot Settings
BOT_WEBHOOK_URL=https://your-domain.com/webhook
BOT_PORT=3000
