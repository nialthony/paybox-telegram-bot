# Copy this file to .env and replace every placeholder before starting Docker Compose.
# Never commit the resulting .env file.

POSTGRES_USER=paybox
# Use a URL-safe password (letters, numbers, hyphen, underscore), for example: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=paybox

TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
PAYBOX_API_KEY=replace-with-your-paybox-api-key

# docker-compose.yml supplies DATABASE_URL to the bot using the PostgreSQL service.
RECONCILIATION_INTERVAL_MS=30000
HEALTH_HOST=0.0.0.0
HEALTH_PORT=3000

# Keep money movement and signing disabled until staging gates are approved.
ENABLE_WALLET_TRANSFERS=false
PAYBOX_TRANSFER_ADAPTER_CONFIRMED=false
# Set to true and restart immediately to stop new transfer creation.
PAYBOX_WALLET_TRANSFERS_KILL_SWITCH=false
# PAYBOX_SIGNING_KEY=
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
