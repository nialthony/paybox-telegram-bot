{
  "name": "paybox-telegram-bot",
  "version": "1.0.0",
  "description": "Telegram bot powered by Paybox - Web3 payments in Telegram",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "check": "npm test && find src test scripts -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "db:migrate": "node scripts/migrate.js"
  },
  "keywords": [
    "telegram",
    "bot",
    "paybox",
    "crypto",
    "web3",
    "wallet",
    "payments"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@paybox-sh/sdk": "^0.7.0",
    "dotenv": "^16.3.1",
    "openai": "^4.20.0",
    "pg": "^8.23.0",
    "telegraf": "^4.15.0"
  }
}
